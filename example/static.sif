Header
  CHECK KEYWORDS Warn
  Mesh DB "." "coil"
  Include Path ""
  Results Directory "./"
End

Simulation
  Max Output Level = 5
  Coordinate System = "Axi Symmetric"
  Coordinate Mapping(3) = 1 2 3
  Simulation Type = "Steady state"
  Steady State Max Iterations = 1
  Output Intervals(1) = 1
  Post File = "static.vtu"
End

Constants
  Permittivity of Vacuum = 8.8541878128e-12
  Permeability of Vacuum = 1.25663706212e-6
End

Body 1
  Target Bodies(1) = 1
  Name = "ironCore"
  Equation = 1
  Material = 2
End

Body 2
  Target Bodies(1) = 2
  Name = "coil"
  Equation = 1
  Material = 3
  Body Force = 1
End

Body 3
  Target Bodies(1) = 3
  Name = "air"
  Equation = 1
  Material = 1
End

Solver 1
  Equation = "MgDyn2D"
  Variable = "Potential"
  Procedure = "MagnetoDynamics2D" "MagnetoDynamics2D"
  Exec Solver = Always
  Stabilize = True
  Optimize Bandwidth = True
  Steady State Convergence Tolerance = 1.0e-5
  Nonlinear System Convergence Tolerance = 1.0e-7
  Nonlinear System Max Iterations = 20
  Nonlinear System Newton After Iterations = 3
  Nonlinear System Newton After Tolerance = 1.0e-3
  Nonlinear System Relaxation Factor = 1
  Linear System Solver = Direct
  Linear System Direct Method = Umfpack
End

Solver 2
  Equation = "CalcFields"
  Potential Variable = "Potential"
  Procedure = "MagnetoDynamics" "MagnetoDynamicsCalcFields"
  Calculate Magnetic Field Strength = Logical True
  Calculate Magnetic Flux Density = Logical True
  Calculate Current Density = Logical True
  Exec Solver = Always
  Linear System Solver = Iterative
  Linear System Iterative Method = CG
  Linear System Max Iterations = 500
  Linear System Convergence Tolerance = 1.0e-8
  Linear System Preconditioning = ILU0
End

Equation 1
  Name = "MagnetoStatics"
  Active Solvers(2) = 1 2
End

Material 1
  Name = "Air"
  Relative Permeability = 1.0
End

Material 2
  Name = "Iron"
  Relative Permeability = 1000.0
End

Material 3
  Name = "Copper"
  Relative Permeability = 1.0
End

Body Force 1
  Name = "CoilCurrent"
  ! 電流密度 [A/m^2]（例: 半径 0.5mm の断面 (面積 約0.785mm^2) に 1A 流す場合は 1.273e6）
  Current Density = 1.0e6
End

Boundary Condition 1
  Target Boundaries(1) = 1
  Name = "axis"
  ! 軸対称 (r = 0) ではベクトルポテンシャル A_phi = 0
  Potential = 0.0
End

Boundary Condition 2
  Target Boundaries(1) = 2
  Name = "outer"
  ! 外部境界（無限遠境界条件、または Potential = 0.0）
  Infinity BC = True
End
