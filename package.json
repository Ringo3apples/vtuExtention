{
  "name": "vtu-node-processor",
  "displayName": "VTU Node Processor",
  "description": "VTU No-Code Data Flow Studio (WebGPU / WebGL2 Node Processor) for viewing and analyzing .vtu files in VS Code.",
  "version": "0.2.0",
  "publisher": "Ringo3Apples",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ringo3apples/vtuExtention.git"
  },
  "license": "MIT",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onCustomEditor:vtuNodeProcessor.vtuEditor",
    "onCommand:vtuNodeProcessor.openViewer",
    "onCommand:vtuNodeProcessor.openFile",
    "onCommand:vtuNodeProcessor.openInSharedViewer"
  ],
  "main": "./extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "vtuNodeProcessor.vtuEditor",
        "displayName": "VTU Node Processor",
        "selector": [
          {
            "filenamePattern": "*.vtu"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vtuNodeProcessor.openViewer",
        "title": "VTU: Open Node Processor"
      },
      {
        "command": "vtuNodeProcessor.openFile",
        "title": "Open in VTU Node Processor"
      },
      {
        "command": "vtuNodeProcessor.openInSharedViewer",
        "title": "VTU: Open in Shared Viewer"
      }
    ],
    "configuration": {
      "title": "VTU Node Processor",
      "properties": {
        "vtuNodeProcessor.singleViewerMode": {
          "type": "boolean",
          "default": true,
          "description": "ONにすると、別の .vtu ファイルを開いたときに新規タブを開かず、1つの共有ビューアーパネルに読み込んで表示位置とノード構成を維持します。"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "vtuNodeProcessor.openInSharedViewer",
          "when": "resourceExtname == .vtu",
          "group": "navigation"
        },
        {
          "command": "vtuNodeProcessor.openFile",
          "when": "resourceExtname == .vtu",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "vtuNodeProcessor.openInSharedViewer",
          "when": "resourceExtname == .vtu",
          "group": "navigation"
        },
        {
          "command": "vtuNodeProcessor.openFile",
          "when": "resourceExtname == .vtu",
          "group": "navigation"
        }
      ]
    },
    "languages": [
      {
        "id": "sif",
        "aliases": ["Elmer SIF", "sif"],
        "extensions": [".sif"],
        "configuration": "./syntaxes/sif-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sif",
        "scopeName": "source.sif",
        "path": "./syntaxes/sif.tmLanguage.json"
      }
    ]
  },
  "dependencies": {
    "three": "0.170.0"
  }
}

